<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1B2430"
    android:padding="14dp">
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ROYALPARK"
        android:textStyle="bold"
        android:textColor="#56D7C1"
        android:textSize="14sp"/>
    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Kein Parkplatz gespeichert"
        android:textColor="#F4F9FB"
        android:textSize="13sp"
        android:paddingTop="6dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/widget_open" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="42dp" android:gravity="center"
            android:text="Öffnen" android:textColor="#FFFFFF"/>
        <TextView android:id="@+id/widget_save" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="42dp" android:gravity="center"
            android:text="＋ Merken" android:textStyle="bold" android:textColor="#56D7C1"/>
    </LinearLayout>
</LinearLayout>
