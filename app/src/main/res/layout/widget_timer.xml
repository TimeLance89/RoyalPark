<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="#FFFFFF">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="ROYALPARK · PARKUHR" android:textColor="#1D92AB"
        android:textStyle="bold" android:textSize="12sp" />
    <TextView android:id="@+id/timer_status"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:textColor="#263746"
        android:textSize="14sp" android:gravity="center_vertical" />
    <TextView android:id="@+id/timer_button" android:layout_width="match_parent"
        android:layout_height="36dp" android:text="◷ Parkuhr einstellen"
        android:textColor="#FFFFFF" android:gravity="center" android:background="#58C4D5" />
</LinearLayout>